# Bối cảnh build gọn: không đưa venv Windows, git, dữ liệu bệnh nhân và model vào image.
.venv/
venv/
env/

.git/
.github/
.gitignore

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Dữ liệu và kết quả runtime (mount qua volume)
output/
runs/
data/
*.db
*.log
*.tmp

# Model lớn: mount qua volume ./models:/app/models
models/pretrained/
models/trained/
models/exported/

# Máy host / IDE
.idea/
.vscode/
Thumbs.db
.DS_Store

# Session và cache của Junie AI
.ua/
.understand-anything/
.junie/

# File nhạy cảm
.env
.env.*
*.pem
*.key

# Scripts build Windows không cần trong Docker
*.bat
*.ps1
*.spec

# Documentation không cần trong runtime image
docs/
