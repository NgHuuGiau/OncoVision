MONAI_MODELS_SUMMARY.md
DOWNLOAD_GUIDE.md

# Test và training scripts không cần trong production image
conftest.py
pytest.ini
tests/

# Scripts dev không cần trong production
scripts/train_*
scripts/probe_*
scripts/check_*
scripts/generate_*

