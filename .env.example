# OncoVision — biến môi trường thực sự được code đọc.
# Không có dotenv: file này KHÔNG tự được nạp. Hãy export trong shell,
# dùng `env_file:` của docker compose, hoặc Environment= của systemd.

# Bắt buộc khi ONCOVISION_ENV=production: >= 32 ký tự.
# Dev để trống thì app tự sinh secret tạm (mất session khi restart).
ONCOVISION_SESSION_SECRET=

# development | production
ONCOVISION_ENV=development
# Đặt 1 khi chạy sau HTTPS.
ONCOVISION_COOKIE_SECURE=0
# Số ca phân tích chạy song song.
ONCOVISION_MAX_CONCURRENT_ANALYSIS=1
# Bind address của web app (0.0.0.0 khi chạy trong container).
ONCOVISION_HOST=127.0.0.1

# 1 = thiếu trọng số pretrained thì fail ngay thay vì chạy với weight ngẫu nhiên.
ONCOVISION_REQUIRE_PRETRAINED=0

# SMTP gửi email khôi phục mật khẩu (để trống thì tắt tính năng).
ONCOVISION_SMTP_HOST=smtp.gmail.com
ONCOVISION_SMTP_PORT=587
ONCOVISION_SMTP_USERNAME=
ONCOVISION_SMTP_PASSWORD=
ONCOVISION_SMTP_FROM=
